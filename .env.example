# Expo exposes EXPO_PUBLIC_* variables in the app bundle. Never put secrets here.
# Android emulator: http://10.0.2.2:4000/api/v1
# iOS simulator: http://localhost:4000/api/v1
# Physical device: use your computer's LAN address instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
# Cloudflare Turnstile public site key (login + guest chat). Dev falls back to the always-pass test key.
# EXPO_PUBLIC_TURNSTILE_SITE_KEY=
# Hostname allowed by the Turnstile widget for the in-app WebView.
# EXPO_PUBLIC_TURNSTILE_ORIGIN=https://localhost
# Public web app origin for share links.
# EXPO_PUBLIC_WEB_URL=https://vedora.app
