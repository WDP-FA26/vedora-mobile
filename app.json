{
  "expo": {
    "name": "vedora-mobile",
    "slug": "vedora-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/app-icon.png",
    "scheme": "vedoramobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#255d32",
        "foregroundImage": "./assets/branding/android-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#255d32",
          "image": "./assets/branding/logo-mark.png",
          "imageWidth": 150
        }
      ],
      "expo-secure-store",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Vedora cần truy cập thư viện để bạn chọn video hướng dẫn đăng bài.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
