{
  "expo": {
    "name": "vedora-mobile",
    "slug": "vedora-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/app-icon.png",
    "scheme": "vedoramobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/app-icon.png",
      "bundleIdentifier": "com.vedora.app"
    },
    "android": {
      "package": "com.vedora.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#255d32",
        "foregroundImage": "./assets/branding/android-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#255d32",
          "image": "./assets/branding/logo-mark.png",
          "imageWidth": 150
        }
      ],
      "expo-secure-store",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Vedora cần truy cập thư viện để bạn chọn video hướng dẫn đăng bài.",
          "cameraPermission": false,
          "microphonePermission": "Vedora cần dùng mic để bạn trò chuyện với trợ lý giọng nói."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Vedora cần dùng mic để bạn trò chuyện với trợ lý giọng nói.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vedora dùng vị trí để tìm nhà hàng gần bạn và ghim vị trí quán.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "60cee5be-bd27-439e-898e-5a2e48c12350"
      }
    },
    "owner": "kaorihzemou"
  }
}
