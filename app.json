{
  "expo": {
    "name": "vedora-mobile",
    "slug": "vedora-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/app-icon.png",
    "scheme": "vedoramobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/app-icon.png"
    },
    "android": {
      "package": "com.vedora.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#255d32",
        "foregroundImage": "./assets/branding/android-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#255d32",
          "image": "./assets/branding/logo-mark.png",
          "imageWidth": 150
        }
      ],
      "expo-secure-store",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Vedora cần truy cập thư viện để bạn chọn video hướng dẫn đăng bài.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8e1bb0f4-c168-4783-8570-8b1125c0bf11"
      }
    },
    "owner": "ngochivy"
  }
}
